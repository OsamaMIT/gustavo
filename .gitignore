*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.hypothesis/

# Virtual environments and local Python installs
.venv/
venv/
env/
ENV/
.python-version

# Packaging and build outputs
build/
dist/
*.egg-info/
.eggs/
